{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{unet}}", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{text_encoder}}", "type": "flux3", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
  "4": {"class_type": "ModelSamplingFlux", "inputs": {"model": ["1", 0], "max_shift": "{{shift}}", "base_shift": "{{shift}}", "width": "{{width}}", "height": "{{height}}"}},
  "5": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
  "8": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["2", 0]}},
  "10": {"class_type": "ReferenceMultiLatent", "inputs": {"positive": ["6", 0], "negative": ["8", 0], "vae": ["3", 0], "images.image0": ["5", 0], "mode": "resize", "scale": 1.0}},
  "12": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "16": {"class_type": "KSampler", "inputs": {"model": ["4", 0], "positive": ["10", 0], "negative": ["10", 1], "latent_image": ["12", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["3", 0]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "imagegen", "images": ["17", 0]}}
}
