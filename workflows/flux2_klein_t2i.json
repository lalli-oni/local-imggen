{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{unet}}", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{text_encoder}}", "type": "flux2", "device": "default"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
  "8": {"class_type": "ConditioningZeroOut", "inputs": {"conditioning": ["6", 0]}},
  "11": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["6", 0], "negative": ["8", 0], "cfg": 1.0}},
  "12": {"class_type": "EmptyFlux2LatentImage", "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": 1}},
  "13": {"class_type": "Flux2Scheduler", "inputs": {"steps": "{{steps}}", "width": "{{width}}", "height": "{{height}}"}},
  "14": {"class_type": "RandomNoise", "inputs": {"noise_seed": "{{seed}}"}},
  "15": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "16": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["14", 0], "guider": ["11", 0], "sampler": ["15", 0], "sigmas": ["13", 0], "latent_image": ["12", 0]}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["3", 0]}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "imagegen", "images": ["17", 0]}}
}
