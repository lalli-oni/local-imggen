{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "{{unet}}", "weight_dtype": "{{weight_dtype}}"}},
  "2": {"class_type": "QwenImage21Cache", "inputs": {"model": ["1", 0], "device": "auto", "dtype": "default"}},
  "3": {"class_type": "CLIPLoader", "inputs": {"clip_name": "{{text_encoder}}", "type": "qwen_image", "device": "default"}},
  "4": {"class_type": "VAELoader", "inputs": {"vae_name": "{{vae}}"}},
  "5": {"class_type": "LoadImage", "inputs": {"image": "{{image}}"}},
  "6": {"class_type": "TextEncodeQwenImage21", "inputs": {"clip": ["3", 0], "vae": ["4", 0], "prompt": "{{prompt}}", "negative_prompt": "", "resolution": "{{resolution}}", "images.image_1": ["5", 0]}},
  "7": {"class_type": "KSampler", "inputs": {"seed": "{{seed}}", "steps": "{{steps}}", "cfg": 1.0, "sampler_name": "euler", "scheduler": "simple", "denoise": 1.0, "model": ["2", 0], "positive": ["6", 0], "negative": ["6", 1], "latent_image": ["6", 2]}},
  "8": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["7", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 8}},
  "20": {"class_type": "UpscaleModelLoader", "inputs": {"model_name": "{{upscale_model}}"}},
  "21": {"class_type": "ImageUpscaleWithModel", "inputs": {"upscale_model": ["20", 0], "image": ["8", 0]}},
  "22": {"class_type": "ImageScale", "inputs": {"image": ["21", 0], "upscale_method": "lanczos", "width": "{{target_width}}", "height": "{{target_height}}", "crop": "center"}},
  "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "imagegen", "images": ["22", 0]}}
}
